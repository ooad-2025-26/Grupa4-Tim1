@model smartPark.Models.Entities.Parking

@{
    ViewBag.Title = "Obriši parking";
}

<div class="container py-4">
    <div class="row mb-4">
        <div class="col-12">
            <button onclick="history.back()" class="btn btn-back mb-3"><i class="bi bi-arrow-left"></i> Nazad</button>
            <h2 class="fw-bold mb-1 text-danger">Obriši parking</h2>
            <p class="text-muted">Da li ste sigurni da želite obrisati ovaj parking prostor?</p>
        </div>
    </div>

    <div class="row">
        <div class="col-md-6 mx-auto">
            <div class="sp-card border border-danger">
                <div class="text-center mb-4">
                    <i class="bi bi-exclamation-triangle fs-1 text-danger"></i>
                    <h4 class="mt-2 text-danger fw-bold">Upozorenje!</h4>
                    <p class="text-muted small">Brisanjem ovog parkinga obrisat ćete i sve pripadajuće podatke, uključujući i istoriju rezervacija.</p>
                </div>

                <div class="mb-4">
                    <table class="table table-sm">
                        <tr>
                            <td class="text-muted">Naziv:</td>
                            <td class="fw-semibold">@Model.Naziv</td>
                        </tr>
                        <tr>
                            <td class="text-muted">Adresa:</td>
                            <td>@Model.Adresa</td>
                        </tr>
                        <tr>
                            <td class="text-muted">Ukupno mjesta:</td>
                            <td>@Model.UkupnoMjesta</td>
                        </tr>
                        <tr>
                            <td class="text-muted">Cijena po satu:</td>
                            <td>@Model.CijenaPoSatu.ToString("F2") KM</td>
                        </tr>
                        <tr>
                            <td class="text-muted">Tip:</td>
                            <td>@Model.TipParkinga</td>
                        </tr>
                    </table>
                </div>

                <form asp-action="DeleteConfirmed" asp-route-id="@Model.ParkingId" method="post">
                    @Html.AntiForgeryToken()
                    <div class="d-flex gap-2 justify-content-end">
                        <a asp-action="Index" class="btn btn-outline-secondary">Otkaži</a>
                        <button type="submit" class="btn btn-danger"><i class="bi bi-trash"></i> Da, obriši parking</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
