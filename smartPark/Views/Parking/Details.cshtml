@model smartPark.Models.ViewModels.Parking.ParkingDetailsViewModel

@{
    ViewBag.Title = Model?.Naziv ?? "Detalji parkinga";
}

<button onclick="history.back()" class="btn btn-back mb-2"><i class="bi bi-arrow-left"></i> Nazad</button>

@if (Model != null)
{
    <div class="sp-card">
        <div class="d-flex justify-content-between flex-wrap gap-2">
            <div>
                <h1 class="h3 mb-1">@Model.Naziv</h1>
                <div class="text-muted-sp"><i class="bi bi-geo-alt"></i> @Model.Adresa</div>
            </div>
            <span class="badge-status @(Model.ZauzetostProcenat < 80 ? "badge-active" : "badge-cancelled")">
                @Model.SlobodnaMjesta / @Model.UkupnoMjesta slobodno
            </span>
        </div>
        <hr/>
        <div class="row g-3">
            <div class="col-md-4"><strong>Tip:</strong> @Model.TipParkingaTekst</div>
            <div class="col-md-4"><strong>Radno vrijeme:</strong> @(!string.IsNullOrEmpty(Model.RadnoVrijeme) ? Model.RadnoVrijeme : "24/7")</div>
            <div class="col-md-4"><strong>Cijena:</strong> @Model.CijenaPoSatu.ToString("F2") KM/h</div>
        </div>
        <hr/>
        <h5>Tarife</h5>
        <ul class="list-unstyled small">
            <li>Standardna: <strong>@Model.CijenaPoSatu.ToString("F2") KM/h</strong></li>
            <li>Noćna (22–06h): <strong>@(Model.CijenaPoSatu * 0.7m).ToString("F2") KM/h</strong></li>
            <li>Vikend: <strong>@(Model.CijenaPoSatu * 1.2m).ToString("F2") KM/h</strong></li>
        </ul>
        <a asp-controller="Rezervacija" asp-action="Kreiraj" asp-route-parkingId="@Model.ParkingId" class="btn btn-primary">
            Rezerviši mjesto
        </a>
    </div>
}
else
{
    <div class="alert alert-danger">
        <i class="bi bi-exclamation-triangle"></i> Parking nije pronađen.
        <a asp-action="Map" class="alert-link">Vrati se na mapu</a>
    </div>
}
