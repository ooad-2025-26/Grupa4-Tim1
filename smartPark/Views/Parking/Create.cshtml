@{
    ViewData["Title"] = "Dodaj parking";
}

<div class="container py-4" style="max-width:520px">
  <div class="card p-4">
    <h4 class="fw-bold mb-4">Dodaj parking</h4>
    <form action="/manage-parkings.html">
      <div class="mb-3"><label class="form-label small fw-medium">Naziv</label><input class="form-control" required></div>
      <div class="mb-3"><label class="form-label small fw-medium">Adresa</label><input class="form-control" required></div>
      <div class="mb-3"><label class="form-label small fw-medium">Kapacitet</label><input type="number" class="form-control" value="50" required></div>
      <div class="mb-3"><label class="form-label small fw-medium">Zona</label><select class="form-select"><option>Zona 1</option><option>Zona 2</option><option>Zona 3</option><option>Zona 4</option></select></div>
      <div class="mb-3"><label class="form-label small fw-medium">Tip parkinga</label><select class="form-select"><option>Otvoreni parking</option><option>Garaža</option><option>Rampa</option><option>Vanjski</option></select></div>
      <div class="mb-3"><label class="form-label small fw-medium">Radno vrijeme</label><input class="form-control" value="06:00 - 22:00"></div>
      <div class="row mb-3"><div class="col"><label class="form-label small fw-medium">Dnevna cijena (KM/h)</label><input type="number" step="0.5" class="form-control" value="3"></div><div class="col"><label class="form-label small fw-medium">Noćna cijena (KM/h)</label><input type="number" step="0.5" class="form-control" value="1.5"></div></div>
      <div class="d-flex gap-2"><button type="submit" class="btn btn-primary">Sačuvaj</button><a href="@Url.Action("Index", "Parking")" class="btn btn-light">Odustani</a></div>
    </form>
  </div>
</div>