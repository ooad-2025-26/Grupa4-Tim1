@{
    ViewData["Title"] = "Admin izvještaji";
}

<div class="container py-4">
  <div class="d-flex justify-content-between align-items-start mb-4">
    <div class="d-flex align-items-center gap-3"><a href="@Url.Action("AdminDashboard", "Home")" class="text-muted"><i class="bi bi-arrow-left"></i></a><div><h4 class="fw-bold mb-0">Generisanje izvještaja</h4><small class="text-muted">Administrator panel</small></div></div>
    <div class="d-flex gap-2"><button class="btn btn-outline-secondary btn-sm"><i class="bi bi-file-earmark-pdf"></i> PDF</button><button class="btn btn-outline-secondary btn-sm"><i class="bi bi-file-earmark-spreadsheet"></i> Excel</button></div>
  </div>
  <div class="card p-3 mb-4"><div class="row g-2 align-items-end">
    <div class="col-md-4"><label class="form-label small text-muted">Tip izvještaja</label><select class="form-select form-select-sm"><option>Korištenje sistema</option><option>Aktivni korisnici</option><option>Sistemske greške</option></select></div>
    <div class="col-md-4"><label class="form-label small text-muted">Period</label><select class="form-select form-select-sm"><option>Danas</option><option selected>Sedmica</option><option>Mjesec</option></select></div>
    <div class="col-md-4"><button class="btn btn-primary btn-sm w-100"><i class="bi bi-file-text"></i> Generiši izvještaj</button></div>
  </div></div>
  <div class="row g-3 mb-4">
    <div class="col-6 col-lg-3"><div class="card p-3 d-flex flex-row justify-content-between align-items-center"><div><small class="text-muted">Ukupno korisnika</small><p class="fw-bold fs-5 mb-0">1250</p></div><i class="bi bi-people text-primary fs-4"></i></div></div>
    <div class="col-6 col-lg-3"><div class="card p-3 d-flex flex-row justify-content-between align-items-center"><div><small class="text-muted">Aktivne rezervacije</small><p class="fw-bold fs-5 mb-0">170</p></div><i class="bi bi-calendar-check text-primary fs-4"></i></div></div>
    <div class="col-6 col-lg-3"><div class="card p-3 d-flex flex-row justify-content-between align-items-center"><div><small class="text-muted">Sistemske greške</small><p class="fw-bold fs-5 mb-0">2</p></div><i class="bi bi-exclamation-triangle text-warning fs-4"></i></div></div>
    <div class="col-6 col-lg-3"><div class="card p-3 d-flex flex-row justify-content-between align-items-center"><div><small class="text-muted">Ukupni prihodi</small><p class="fw-bold fs-5 mb-0">22200 KM</p></div><i class="bi bi-currency-dollar text-danger fs-4"></i></div></div>
  </div>
  <div class="card p-4 mb-4"><h6 class="fw-semibold">Trend korištenja sistema</h6><small class="text-muted">Pregled aktivnosti tokom sedmice</small><div class="bg-light rounded mt-3 d-flex align-items-center justify-content-center" style="height:240px"><span class="text-muted">[Grafikon - Trend]</span></div></div>
  <div class="card p-4">
    <h6 class="fw-semibold">Detaljni pregled aktivnosti</h6>
    <table class="table table-sm mt-3 small">
      <thead><tr class="text-muted"><th>Datum</th><th>Tip</th><th class="text-end">Korisnika</th><th class="text-end">Rezervacija</th><th class="text-end">Greške</th></tr></thead>
      <tbody>
        <tr><td>2024-01-15</td><td><span class="badge bg-primary bg-opacity-10 text-primary" style="font-size:0.7rem">Prijava</span></td><td class="text-end">245</td><td class="text-end">89</td><td class="text-end">0</td></tr>
        <tr><td>2024-01-16</td><td><span class="badge bg-success bg-opacity-10 text-success" style="font-size:0.7rem">Rezervacija</span></td><td class="text-end">312</td><td class="text-end">112</td><td class="text-end">1</td></tr>
        <tr><td>2024-01-17</td><td><span class="badge bg-danger bg-opacity-10 text-danger" style="font-size:0.7rem">Greška</span></td><td class="text-end">189</td><td class="text-end">67</td><td class="text-end">3</td></tr>
      </tbody>
    </table>
  </div>
</div>