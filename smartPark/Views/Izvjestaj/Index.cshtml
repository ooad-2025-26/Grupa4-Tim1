@model IEnumerable<smartPark.Models.Entities.Izvjestaj>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.DatumGenerisanja)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.PeriodOd)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.PeriodDo)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.UkupnoRezervacija)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.UkupniPrihod)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ParkingId)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.TipIzvjestaja)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Parking)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.DatumGenerisanja)
            </td>
            <td>
                @Html.DisplayFor(model => item.PeriodOd)
            </td>
            <td>
                @Html.DisplayFor(model => item.PeriodDo)
            </td>
            <td>
                @Html.DisplayFor(model => item.UkupnoRezervacija)
            </td>
            <td>
                @Html.DisplayFor(model => item.UkupniPrihod)
            </td>
            <td>
                @Html.DisplayFor(model => item.ParkingId)
            </td>
            <td>
                @Html.DisplayFor(model => item.TipIzvjestaja)
            </td>
            <td>
                @Html.DisplayFor(model => item.Parking)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.IzvjestajId">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.IzvjestajId">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.IzvjestajId">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
