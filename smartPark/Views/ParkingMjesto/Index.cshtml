@model IEnumerable<smartPark.Models.ParkingMjesto>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.ParkingId)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.BrojMjesta)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.StatusMjesta)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Parking)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.TrenutnaRezervacija)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.ParkingId)
            </td>
            <td>
                @Html.DisplayFor(model => item.BrojMjesta)
            </td>
            <td>
                @Html.DisplayFor(model => item.StatusMjesta)
            </td>
            <td>
                @Html.DisplayFor(model => item.Parking)
            </td>
            <td>
                @Html.DisplayFor(model => item.TrenutnaRezervacija)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.ParkingMjestoId">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.ParkingMjestoId">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.ParkingMjestoId">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
