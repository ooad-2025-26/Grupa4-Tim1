@{
    ViewBag.Title = "Pristup odbijen";
}

<div class="min-h-[60vh] flex flex-col items-center justify-center text-center px-4">
    <div class="w-20 h-20 bg-destructive/10 text-destructive rounded-full flex items-center justify-center mb-6">
        <i class="bi bi-shield-lock text-4xl"></i>
    </div>
    
    <h1 class="text-3xl font-bold text-foreground mb-2">Pristup odbijen</h1>
    <p class="text-muted-foreground text-sm max-w-md mb-8">
        Nemate dozvolu za pristup traženoj stranici. Za podršku ili dodatne informacije, kontaktirajte nas putem e-maila na <strong>help@smartpark.ba</strong>.
    </p>
    
    <div class="flex flex-wrap gap-3 justify-center">
        <a href="/" class="inline-flex items-center gap-2 bg-primary text-primary-foreground font-semibold px-5 py-2.5 rounded-lg text-sm hover:opacity-90 transition-opacity no-underline">
            <i class="bi bi-house"></i>
            Početna stranica
        </a>
        <button onclick="history.back()" class="inline-flex items-center gap-2 bg-muted text-foreground font-semibold px-5 py-2.5 rounded-lg text-sm hover:opacity-80 transition-opacity border border-border cursor-pointer">
            <i class="bi bi-arrow-left"></i>
            Nazad
        </button>
    </div>
</div>
