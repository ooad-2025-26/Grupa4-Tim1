<!DOCTYPE html>
<html lang="bs">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] — SmartPark</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" />
    <style>
        body { font-family: 'Segoe UI', system-ui, -apple-system, sans-serif; background: #f7f7f8; }
        .navbar { background: #fff !important; border-bottom: 1px solid #e5e7eb; }
        .navbar-brand { font-weight: 700; letter-spacing: -0.5px; }
        .card { border: 1px solid #e5e7eb; border-radius: 0.75rem; }
        .btn-primary { background: #2563eb; border-color: #2563eb; }
        .btn-primary:hover { background: #1d4ed8; border-color: #1d4ed8; }
        .badge-status { font-size: 0.7rem; padding: 0.25em 0.6em; border-radius: 9999px; font-weight: 500; }
        .badge-active { background: rgba(34,197,94,0.1); color: #16a34a; }
        .badge-upcoming { background: rgba(37,99,235,0.1); color: #2563eb; }
        .badge-expired { background: rgba(107,114,128,0.1); color: #6b7280; }
        .badge-cancelled { background: rgba(239,68,68,0.1); color: #ef4444; }
        .stat-card .stat-icon { width: 44px; height: 44px; border-radius: 0.5rem; display: flex; align-items: center; justify-content: center; font-size: 1.2rem; }
        .stat-card .stat-value { font-size: 1.5rem; font-weight: 700; }
        .stat-card .stat-label { font-size: 0.75rem; color: #6b7280; }
    </style>
    @RenderSection("Head", required: false)
    @RenderSection("Styles", required: false)
</head>
<body>
    @{
        var user = Context.User?.Identity?.IsAuthenticated == true ? Context.User.Identity.Name : null;
        var role = ViewBag.Role as string ?? "driver"; // driver | manager | admin
    }
    <nav class="navbar navbar-expand-md">
        <div class="container">
            <a class="navbar-brand" href="@Url.Action("Index","Home")">SmartPark</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#nav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="nav">
                <ul class="navbar-nav me-auto">
                    @if (role == "admin")
                    {
                        <li class="nav-item"><a class="nav-link" href="@Url.Action("AdminDashboard","Home")">Dashboard</a></li>
                        <li class="nav-item"><a class="nav-link" href="@Url.Action("Index","Korisnik")">Korisnici</a></li>
                        <li class="nav-item"><a class="nav-link" href="@Url.Action("Admin","Izvjestaj")">Izvještaji</a></li>
                        <li class="nav-item"><a class="nav-link" href="@Url.Action("Index","Notifikacija")">Logovi</a></li>
                    }
                    else if (role == "manager")
                    {
                        <li class="nav-item"><a class="nav-link" href="@Url.Action("ManagerDashboard","Home")">Dashboard</a></li>
                        <li class="nav-item"><a class="nav-link" href="@Url.Action("Index","Parking")">Parking prostori</a></li>
                        <li class="nav-item"><a class="nav-link" href="@Url.Action("Index","Cjenovnik")">Cjenovnik</a></li>
                        <li class="nav-item"><a class="nav-link" href="@Url.Action("Manager","Izvjestaj")">Izvještaji</a></li>
                    }
                    else
                    {
                        <li class="nav-item"><a class="nav-link" href="@Url.Action("Index","Home")">Početna</a></li>
                        <li class="nav-item"><a class="nav-link" href="@Url.Action("Map","Parking")">Mapa</a></li>
                        <li class="nav-item"><a class="nav-link" href="@Url.Action("Index","Rezervacija")">Moje rezervacije</a></li>
                        <li class="nav-item"><a class="nav-link" href="@Url.Action("Profile","Korisnik")">Profil</a></li>
                    }
                </ul>
                <div class="d-flex align-items-center gap-3">
                    @if (!string.IsNullOrEmpty(user))
                    {
                        <small class="text-muted">@user</small>
                        <a href="@Url.Action("Logout","Korisnik")" class="btn btn-sm btn-outline-secondary">Odjavi se</a>
                    }
                    else
                    {
                        <a href="@Url.Action("Login","Korisnik")" class="btn btn-sm btn-outline-secondary">Prijava</a>
                    }
                </div>
            </div>
        </div>
    </nav>
    <main>
        @RenderBody()
    </main>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>
