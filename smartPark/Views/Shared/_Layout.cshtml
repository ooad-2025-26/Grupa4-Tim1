@using Microsoft.AspNetCore.Identity
@using smartPark.Models.Entities
@inject UserManager<Korisnik> UserManager
@{
    var uloga = "gost";
    var korisnikIme = "";

    if (User.Identity?.IsAuthenticated == true)
    {
        var korisnik = await UserManager.GetUserAsync(User);
        if (korisnik != null)
        {
            korisnikIme = $"{korisnik.Ime} {korisnik.Prezime}";
            if (await UserManager.IsInRoleAsync(korisnik, "Administrator"))
            {
                uloga = "admin";
            }
            else if (await UserManager.IsInRoleAsync(korisnik, "Menadzer"))
            {
                uloga = "menadzer";
            }
            else if (await UserManager.IsInRoleAsync(korisnik, "Vozac"))
            {
                uloga = "vozac";
            }
        }
    }
}
@functions {
    public string IsActive(string controller, string? action = null)
    {
        var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
        var currentAction = ViewContext.RouteData.Values["action"]?.ToString();

        bool controllerMatch = string.Equals(currentController, controller, StringComparison.OrdinalIgnoreCase);
        bool actionMatch = action == null || string.Equals(currentAction, action, StringComparison.OrdinalIgnoreCase);

        // Special handling for Profil
        if (controller != null && controller.Equals("Korisnik", StringComparison.OrdinalIgnoreCase) && 
            (action != null && action.Equals("Profil", StringComparison.OrdinalIgnoreCase)))
        {
            if (currentController != null && currentController.Equals("Korisnik", StringComparison.OrdinalIgnoreCase) &&
                currentAction != null && (currentAction.Equals("Profil", StringComparison.OrdinalIgnoreCase) || 
                                          currentAction.Equals("MojProfil", StringComparison.OrdinalIgnoreCase)))
            {
                return "active";
            }
        }

        return controllerMatch && actionMatch ? "active" : "";
    }
}
<!DOCTYPE html>
<html lang="bs">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title - SmartPark</title>
    <link rel="icon" type="image/x-icon" href="~/favicon.ico" />
    <link rel="icon" type="image/png" sizes="192x192" href="~/icon-192x192.png" />
    <link rel="icon" type="image/png" sizes="512x512" href="~/icon-512x512.png" />
    <link rel="apple-touch-icon" href="~/apple-touch-icon.png" />
    <!-- Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <!-- Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet" />
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        background: 'hsl(0, 0%, 97%)',
                        foreground: 'hsl(220, 20%, 14%)',
                        card: {
                            DEFAULT: 'hsl(0, 0%, 100%)',
                            foreground: 'hsl(220, 20%, 14%)'
                        },
                        popover: {
                            DEFAULT: 'hsl(0, 0%, 100%)',
                            foreground: 'hsl(220, 20%, 14%)'
                        },
                        primary: {
                            DEFAULT: 'hsl(217, 91%, 53%)',
                            foreground: 'hsl(0, 0%, 100%)'
                        },
                        secondary: {
                            DEFAULT: 'hsl(214, 32%, 91%)',
                            foreground: 'hsl(220, 20%, 14%)'
                        },
                        muted: {
                            DEFAULT: 'hsl(220, 14%, 96%)',
                            foreground: 'hsl(220, 9%, 46%)'
                        },
                        accent: {
                            DEFAULT: 'hsl(214, 32%, 91%)',
                            foreground: 'hsl(220, 20%, 14%)'
                        },
                        destructive: {
                            DEFAULT: 'hsl(0, 84%, 60%)',
                            foreground: 'hsl(0, 0%, 100%)'
                        },
                        success: {
                            DEFAULT: 'hsl(142, 71%, 45%)',
                            foreground: 'hsl(0, 0%, 100%)'
                        },
                        warning: {
                            DEFAULT: 'hsl(45, 93%, 47%)',
                            foreground: 'hsl(0, 0%, 100%)'
                        },
                        info: {
                            DEFAULT: 'hsl(217, 91%, 53%)',
                            foreground: 'hsl(0, 0%, 100%)'
                        },
                        border: 'hsl(220, 13%, 91%)',
                        input: 'hsl(220, 13%, 91%)',
                        ring: 'hsl(217, 91%, 53%)'
                    },
                    borderRadius: {
                        lg: '0.75rem',
                        md: 'calc(0.75rem - 2px)',
                        sm: 'calc(0.75rem - 4px)'
                    },
                    fontFamily: {
                        sans: ['Inter', 'sans-serif']
                    }
                }
            }
        }
    </script>
    <style>
        body {
            background-color: hsl(0, 0%, 97%);
            color: hsl(220, 20%, 14%);
            font-family: 'Inter', sans-serif;
        }
    </style>
    @RenderSection("Head", required: false)
</head>
<body>
<nav class="bg-card border-b border-border">
