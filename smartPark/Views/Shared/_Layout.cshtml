        <a class="font-bold text-lg tracking-tight text-foreground no-underline flex items-center gap-1.5" asp-controller="Home" asp-action="Index">
            <img src="~/LOGO.png" alt="SmartPark Logo" class="h-10 scale-[1.6] origin-left" />
        </a>

        @if (uloga == "vozac")
        {
            <div class="hidden md:flex items-center gap-1">
                <a class="px-3 py-2 text-sm transition-colors no-underline @(IsActive("Home", "Index") == "active" ? "text-foreground font-bold" : "text-muted-foreground hover:text-foreground font-medium")" asp-controller="Home" asp-action="Index">Početna</a>
                <a class="px-3 py-2 text-sm transition-colors no-underline @(IsActive("Parking", "Map") == "active" ? "text-foreground font-bold" : "text-muted-foreground hover:text-foreground font-medium")" asp-controller="Parking" asp-action="Map">Mapa</a>
                <a class="px-3 py-2 text-sm transition-colors no-underline @(IsActive("Rezervacija", "MojeRezervacije") == "active" ? "text-foreground font-bold" : "text-muted-foreground hover:text-foreground font-medium")" asp-controller="Rezervacija" asp-action="MojeRezervacije">Moje rezervacije</a>
                <a class="px-3 py-2 text-sm transition-colors no-underline @(IsActive("Korisnik", "Profil") == "active" ? "text-foreground font-bold" : "text-muted-foreground hover:text-foreground font-medium")" asp-controller="Korisnik" asp-action="Profil">Profil</a>
            </div>
        }
        else if (uloga == "menadzer")
        {
            <div class="hidden md:flex items-center gap-1">
                <a class="px-3 py-2 text-sm transition-colors no-underline @(IsActive("Home", "ManagerDashboard") == "active" ? "text-foreground font-bold" : "text-muted-foreground hover:text-foreground font-medium")" asp-controller="Home" asp-action="ManagerDashboard">Dashboard</a>
                <a class="px-3 py-2 text-sm transition-colors no-underline @(IsActive("Parking", "Index") == "active" ? "text-foreground font-bold" : "text-muted-foreground hover:text-foreground font-medium")" asp-controller="Parking" asp-action="Index">Parking prostori</a>
                <a class="px-3 py-2 text-sm transition-colors no-underline @(IsActive("Cjenovnik", "Index") == "active" ? "text-foreground font-bold" : "text-muted-foreground hover:text-foreground font-medium")" asp-controller="Cjenovnik" asp-action="Index">Cijene</a>
                <a class="px-3 py-2 text-sm transition-colors no-underline @(IsActive("Izvjestaj", "Index") == "active" ? "text-foreground font-bold" : "text-muted-foreground hover:text-foreground font-medium")" asp-controller="Izvjestaj" asp-action="Index">Izvještaji</a>
                <a class="px-3 py-2 text-sm transition-colors no-underline @(IsActive("Korisnik", "Profil") == "active" ? "text-foreground font-bold" : "text-muted-foreground hover:text-foreground font-medium")" asp-controller="Korisnik" asp-action="Profil">Profil</a>
            </div>
        }
        else if (uloga == "admin")
        {
            <div class="hidden md:flex items-center gap-1">
                <a class="px-3 py-2 text-sm transition-colors no-underline @(IsActive("Home", "AdminDashboard") == "active" ? "text-foreground font-bold" : "text-muted-foreground hover:text-foreground font-medium")" 
                asp-controller="Home" asp-action="AdminDashboard">Dashboard</a>
                
                <a class="px-3 py-2 text-sm transition-colors no-underline @(IsActive("Korisnik", "Index") == "active" ? "text-foreground font-bold" : "text-muted-foreground hover:text-foreground font-medium")" 
                asp-controller="Korisnik" asp-action="Index">Korisnici</a>
                
                <a class="px-3 py-2 text-sm transition-colors no-underline @(IsActive("Parking", "Index") == "active" ? "text-foreground font-bold" : "text-muted-foreground hover:text-foreground font-medium")" 
                asp-controller="Parking" asp-action="Index">Parking prostori</a>
                
                <a class="px-3 py-2 text-sm transition-colors no-underline @(IsActive("Korisnik", "Statistika") == "active" ? "text-foreground font-bold" : "text-muted-foreground hover:text-foreground font-medium")" 
                asp-controller="Korisnik" asp-action="Statistika">Izvještaji</a>
                
                <a class="px-3 py-2 text-sm transition-colors no-underline @(IsActive("QRKod", "Scanner") == "active" ? "text-foreground font-bold" : "text-muted-foreground hover:text-foreground font-medium")" 
                asp-controller="QRKod" asp-action="Scanner">QR Skener</a>
                
                <a class="px-3 py-2 text-sm transition-colors no-underline @(IsActive("Korisnik", "Profil") == "active" ? "text-foreground font-bold" : "text-muted-foreground hover:text-foreground font-medium")" 
                asp-controller="Korisnik" asp-action="Profil">Profil</a>
            </div>
}

        <!-- Right Side Nav -->
        <div class="flex items-center gap-3">
            @if (!string.IsNullOrEmpty(korisnikIme))
            {
                <div class="hidden md:flex items-center gap-3">
                    <span class="text-sm text-foreground font-bold">@korisnikIme</span>
                    <form asp-controller="Korisnik" asp-action="Logout" method="post" class="m-0">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="text-xs font-semibold text-foreground border border-border bg-card hover:bg-muted px-3 py-1.5 rounded transition-all cursor-pointer">Odjavi se</button>
                    </form>
                </div>
            }
            else
            {
                <div class="hidden md:flex items-center gap-2">
                    <a class="px-3 py-2 text-sm transition-colors no-underline text-muted-foreground hover:text-foreground" asp-controller="Korisnik" asp-action="Register">Registracija</a>
                    <a class="px-3 py-2 text-sm transition-colors no-underline text-muted-foreground hover:text-foreground" asp-controller="Korisnik" asp-action="Login">Prijava</a>
                </div>
            }

            <!-- Hamburger Button for Mobile -->
            <button onclick="toggleMobileMenu()" class="flex md:hidden text-muted-foreground hover:text-foreground bg-transparent border-0 cursor-pointer p-1" title="Meni">
                <i class="bi bi-list text-2xl"></i>
            </button>
        </div>
    </div>

    <!-- Mobile Collapsible Menu Drawer -->
    <div id="mobileMenu" class="hidden md:hidden border-t border-border px-4 py-3 bg-card space-y-1">
        @if (uloga == "vozac")
        {
            <a class="block px-3 py-2 text-sm rounded-md no-underline @(IsActive("Home", "Index") == "active" ? "bg-muted text-foreground font-semibold" : "text-muted-foreground")" asp-controller="Home" asp-action="Index">Početna</a>
            <a class="block px-3 py-2 text-sm rounded-md no-underline @(IsActive("Parking", "Map") == "active" ? "bg-muted text-foreground font-semibold" : "text-muted-foreground")" asp-controller="Parking" asp-action="Map">Mapa</a>
            <a class="block px-3 py-2 text-sm rounded-md no-underline @(IsActive("Rezervacija", "MojeRezervacije") == "active" ? "bg-muted text-foreground font-semibold" : "text-muted-foreground")" asp-controller="Rezervacija" asp-action="MojeRezervacije">Moje rezervacije</a>
            <a class="block px-3 py-2 text-sm rounded-md no-underline @(IsActive("Korisnik", "Profil") == "active" ? "bg-muted text-foreground font-semibold" : "text-muted-foreground")" asp-controller="Korisnik" asp-action="Profil">Profil</a>
        }
        else if (uloga == "menadzer")
        {
            <a class="block px-3 py-2 text-sm rounded-md no-underline @(IsActive("Home", "ManagerDashboard") == "active" ? "bg-muted text-foreground font-semibold" : "text-muted-foreground")" asp-controller="Home" asp-action="ManagerDashboard">Dashboard</a>
            <a class="block px-3 py-2 text-sm rounded-md no-underline @(IsActive("Parking", "Index") == "active" ? "bg-muted text-foreground font-semibold" : "text-muted-foreground")" asp-controller="Parking" asp-action="Index">Parking prostori</a>
            <a class="block px-3 py-2 text-sm rounded-md no-underline @(IsActive("Cjenovnik", "Index") == "active" ? "bg-muted text-foreground font-semibold" : "text-muted-foreground")" asp-controller="Cjenovnik" asp-action="Index">Cijene</a>
            <a class="block px-3 py-2 text-sm rounded-md no-underline @(IsActive("Izvjestaj", "Index") == "active" ? "bg-muted text-foreground font-semibold" : "text-muted-foreground")" asp-controller="Izvjestaj" asp-action="Index">Izvještaji</a>
            <a class="block px-3 py-2 text-sm rounded-md no-underline @(IsActive("Korisnik", "Profil") == "active" ? "bg-muted text-foreground font-semibold" : "text-muted-foreground")" asp-controller="Korisnik" asp-action="Profil">Profil</a>
        }
        else if (uloga == "admin")
        {
            <a class="block px-3 py-2 text-sm rounded-md no-underline @(IsActive("Korisnik", "Index") == "active" ? "bg-muted text-foreground font-semibold" : "text-muted-foreground")" 
            asp-controller="Korisnik" asp-action="Index">Korisnici</a>
            
            <a class="block px-3 py-2 text-sm rounded-md no-underline @(IsActive("Parking", "Index") == "active" ? "bg-muted text-foreground font-semibold" : "text-muted-foreground")" 
            asp-controller="Parking" asp-action="Index">Parking prostori</a>
            
            <a class="block px-3 py-2 text-sm rounded-md no-underline @(IsActive("Korisnik", "Statistika") == "active" ? "bg-muted text-foreground font-semibold" : "text-muted-foreground")" 
            asp-controller="Korisnik" asp-action="Statistika">Izvještaji</a>
            
            <a class="block px-3 py-2 text-sm rounded-md no-underline @(IsActive("QRKod", "Scanner") == "active" ? "bg-muted text-foreground font-semibold" : "text-muted-foreground")" 
            asp-controller="QRKod" asp-action="Scanner">QR Skener</a>
            
            <a class="block px-3 py-2 text-sm rounded-md no-underline @(IsActive("Korisnik", "Profil") == "active" ? "bg-muted text-foreground font-semibold" : "text-muted-foreground")" 
            asp-controller="Korisnik" asp-action="Profil">Profil</a>
        }

        <div class="border-t border-border pt-2 mt-2">
            @if (!string.IsNullOrEmpty(korisnikIme))
            {
                <div class="flex items-center justify-between px-3 py-1">
                    <span class="text-xs text-muted-foreground">@korisnikIme</span>
                    <form asp-controller="Korisnik" asp-action="Logout" method="post" class="m-0">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="text-xs text-destructive hover:underline bg-transparent border-0 p-0 cursor-pointer">Odjavi se</button>
                    </form>
