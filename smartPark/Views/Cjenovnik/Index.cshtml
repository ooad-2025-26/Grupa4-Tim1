@{
    ViewData["Title"] = "Cjenovnik";
}

<div class="container py-4" style="max-width:520px">
  <h4 class="fw-bold mb-4">Upravljanje cijenama</h4>
  <div class="card p-4">
    <div class="mb-3"><label class="form-label small fw-medium">Parking</label><select class="form-select"><option>Centar - Zona 1</option><option>Tržni Centar Delta</option><option>Aerodrom - Terminal A</option><option>Bolnica - Glavni ulaz</option><option>BBI Centar</option><option>Skenderija</option></select></div>
    <div class="mb-3"><label class="form-label small fw-medium">Standardna satnica (KM)</label><input type="number" step="0.5" class="form-control" value="2.5"></div>
    <div class="mb-3"><label class="form-label small fw-medium">Noćna tarifa (22:00-06:00) (KM)</label><input type="number" step="0.5" class="form-control" value="1.5"></div>
    <div class="mb-3"><label class="form-label small fw-medium">Vikend tarifa (KM)</label><input type="number" step="0.5" class="form-control" value="2"></div>
    <button class="btn btn-primary w-100">Sačuvaj izmjene</button>
  </div>
</div>