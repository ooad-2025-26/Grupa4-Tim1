@model smartPark.Models.ViewModels.Korisnik.Admin.AdminKorisnikUrediViewModel

@{
    ViewBag.Title = "Uredi korisnika";
}

<div class="container mx-auto px-4 py-8">
    <!-- Header -->
    <div class="flex items-center gap-3 mb-6">
        <button onclick="history.back()" class="text-muted-foreground hover:text-foreground text-xl bg-transparent border-0 p-0 cursor-pointer" title="Nazad">
            <i class="bi bi-arrow-left"></i>
        </button>
        <div>
            <h1 class="text-2xl font-bold text-foreground">Uredi korisnika</h1>
            <p class="text-xs text-muted-foreground mt-0.5">Ažurirajte korisničke podatke u sistemu</p>
        </div>
    </div>

    <div class="max-w-2xl mx-auto">
        <div class="bg-card rounded-xl border border-border p-6 shadow-sm hover:shadow-md transition-shadow">
            <form asp-action="Uredi" asp-route-id="@Model.Id" method="post" id="urediKorisnikaForm" class="space-y-6">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />
                <div asp-validation-summary="ModelOnly" class="bg-destructive/10 border border-destructive/20 text-destructive text-xs px-4 py-3 rounded-lg"></div>

                <!-- Ime i Prezime -->
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div>
                        <label asp-for="Ime" class="block text-xs font-semibold text-muted-foreground mb-1.5">Ime</label>
                        <input asp-for="Ime" class="w-full px-3 py-2 rounded-lg border border-input bg-card text-foreground text-sm focus:outline-none focus:ring-2 focus:ring-ring shadow-sm" placeholder="Unesite ime" />
                        <span asp-validation-for="Ime" class="text-destructive text-[11px] mt-1 block"></span>
                    </div>
                    <div>
                        <label asp-for="Prezime" class="block text-xs font-semibold text-muted-foreground mb-1.5">Prezime</label>
                        <input asp-for="Prezime" class="w-full px-3 py-2 rounded-lg border border-input bg-card text-foreground text-sm focus:outline-none focus:ring-2 focus:ring-ring shadow-sm" placeholder="Unesite prezime" />
                        <span asp-validation-for="Prezime" class="text-destructive text-[11px] mt-1 block"></span>
                    </div>
                </div>

                <!-- Email -->
                <div>
                    <label asp-for="Email" class="block text-xs font-semibold text-muted-foreground mb-1.5">Email adresa</label>
                    <input asp-for="Email" class="w-full px-3 py-2 rounded-lg border border-input bg-card text-foreground text-sm focus:outline-none focus:ring-2 focus:ring-ring shadow-sm" type="email" placeholder="example@domain.com" />
                    <span asp-validation-for="Email" class="text-destructive text-[11px] mt-1 block"></span>
                </div>

                <!-- Uloga -->
                <div>
                    <label asp-for="Uloga" class="block text-xs font-semibold text-muted-foreground mb-1.5">Uloga u sistemu</label>
                    <select asp-for="Uloga" asp-items="Model.DostupneUloge" class="w-full px-3 py-2 rounded-lg border border-input bg-card text-foreground text-sm focus:outline-none focus:ring-2 focus:ring-ring shadow-sm" id="ulogaSelect">
                        <option value="">Odaberite ulogu...</option>
                    </select>
                    <span asp-validation-for="Uloga" class="text-destructive text-[11px] mt-1 block"></span>
                </div>

                <!-- Broj vozačke (Conditional) -->
                <div class="hidden" id="brojVozackeDiv">
                    <label asp-for="BrojVozacke" class="block text-xs font-semibold text-muted-foreground mb-1.5">Broj vozačke dozvole</label>
                    <input asp-for="BrojVozacke" class="w-full px-3 py-2 rounded-lg border border-input bg-card text-foreground text-sm focus:outline-none focus:ring-2 focus:ring-ring shadow-sm" placeholder="Unesite broj vozačke" />
                    <span asp-validation-for="BrojVozacke" class="text-destructive text-[11px] mt-1 block"></span>
                </div>

                <!-- Status Switches -->
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-2">
                    <div class="flex items-center gap-3">
                        <input asp-for="Aktivan" type="checkbox" id="aktivanSwitch" class="w-4 h-4 text-primary bg-card border-input rounded focus:ring-primary focus:ring-2 cursor-pointer" />
                        <label class="text-sm font-medium text-foreground cursor-pointer select-none" for="aktivanSwitch">Korisnički račun aktivan</label>
                    </div>
                    <div class="flex items-center gap-3">
                        <input asp-for="Zakljucan" type="checkbox" id="zakljucanSwitch" class="w-4 h-4 text-primary bg-card border-input rounded focus:ring-primary focus:ring-2 cursor-pointer" />
                        <label class="text-sm font-medium text-foreground cursor-pointer select-none" for="zakljucanSwitch">Korisnički račun zaključan</label>
                    </div>
                </div>

                <!-- Action Buttons -->
                <div class="flex justify-end gap-3 pt-6 border-t border-border">
                    <a asp-action="Index" class="px-4 py-2 text-sm font-semibold text-foreground border border-border bg-card hover:bg-muted rounded-lg transition-colors no-underline">Otkaži</a>
                    <button type="submit" class="inline-flex items-center gap-2 bg-primary text-primary-foreground font-semibold px-4 py-2 rounded-lg text-sm hover:opacity-90 transition-opacity border-0 cursor-pointer">
                        <i class="bi bi-save"></i> Sačuvaj izmjene
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener("DOMContentLoaded", function() {
            var ulogaSelect = document.getElementById("ulogaSelect");
            var vozackeDiv = document.getElementById("brojVozackeDiv");

            function toggleFields() {
                var selected = ulogaSelect.value;
                if (selected === "Vozac" || selected === "driver") {
                    vozackeDiv.classList.remove("hidden");
                } else {
                    vozackeDiv.classList.add("hidden");
                }
            }

            ulogaSelect.addEventListener("change", toggleFields);
            toggleFields(); // Initial run
        });
    </script>
}
