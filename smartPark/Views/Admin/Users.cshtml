@model smartPark.Models.ViewModels.Korisnik.Admin.AdminKorisnikListaViewModel

@{
    ViewBag.Title = "Upravljanje korisnicima";
    bool jePretrazeno = Context.Request.Query.ContainsKey("pretrazeno");
}

<div class="container mx-auto px-4 py-8">
    <!-- Header -->
    <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 mb-6">
        <div class="flex items-center gap-3">
            <button onclick="history.back()" class="text-muted-foreground hover:text-foreground text-xl bg-transparent border-0 p-0 cursor-pointer">
                <i class="bi bi-arrow-left"></i>
            </button>
            <div>
                <h1 class="text-2xl font-bold text-foreground">Upravljanje korisnicima</h1>
                <p class="text-xs text-muted-foreground mt-0.5">Administrator panel</p>
            </div>
        </div>
        <div class="flex items-center gap-2">
            <a href="/admin/korisnici/dodaj" class="inline-flex items-center gap-2 bg-primary text-primary-foreground font-semibold px-4 py-2.5 rounded-lg text-sm hover:opacity-90 transition-opacity no-underline">
                <i class="bi bi-person-plus"></i> Dodaj korisnika
            </a>
        </div>
    </div>

    <!-- Filteri / Search -->
    <div class="bg-card rounded-xl border border-border p-4 mb-6 shadow-sm">
        <form method="get" action="/admin/korisnici" id="filterForm">
            <div class="grid grid-cols-1 md:grid-cols-4 gap-4 items-end">
                <div class="md:col-span-2">
                    <label class="text-xs font-semibold text-muted-foreground block mb-1.5">Pretraži korisnike</label>
                    <div class="relative">
                        <i class="bi bi-search absolute left-3.5 top-1/2 -translate-y-1/2 text-muted-foreground text-sm pointer-events-none"></i>
                        <input id="korisnikSearchInput" name="pretraga" value="@Model.FilterPretraga" placeholder="Pretraži po imenu ili emailu..." class="w-full pl-10 pr-4 py-2 rounded-lg border border-input bg-card text-foreground text-sm focus:outline-none focus:ring-2 focus:ring-ring shadow-sm" />
                    </div>
                </div>

                <div>
                    <label class="text-xs font-semibold text-muted-foreground block mb-1.5">Uloga</label>
                    <select name="uloga" class="w-full px-3 py-2 rounded-lg border border-input bg-card text-foreground text-sm focus:outline-none focus:ring-2 focus:ring-ring shadow-sm">
                        <option value="">Sve uloge</option>
                        @foreach (var uloga in Model.DostupneUloge)
                        {
                            <option value="@uloga" selected="@(uloga == Model.FilterUloga ? "selected" : null)">@uloga</option>
                        }
                    </select>
                </div>

                <div>
                    <label class="text-xs font-semibold text-muted-foreground block mb-1.5">Status</label>
                    <select name="status" class="w-full px-3 py-2 rounded-lg border border-input bg-card text-foreground text-sm focus:outline-none focus:ring-2 focus:ring-ring shadow-sm">
                        <option value="">Svi statusi</option>
                        <option value="Aktivni" selected="@(Model.FilterStatus == "Aktivni" ? "selected" : null)">Aktivni</option>
                        <option value="Neaktivni" selected="@(Model.FilterStatus == "Neaktivni" ? "selected" : null)">Neaktivni</option>
                    </select>
                </div>
                <input type="hidden" name="pretrazeno" value="true" />
            </div>
            <div class="flex justify-between items-center mt-4 pt-3 border-t border-border">
                <!-- Dugmad za izvoz -->
                <div class="flex gap-2">
                    @{
                        string disabledAttr = jePretrazeno ? "" : "disabled";
                        string disabledClass = jePretrazeno ? "cursor-pointer" : "opacity-50 cursor-not-allowed";
                    }
                    <button type="button" onclick="exportKorisnici('pdf')" @disabledAttr id="exportPdfBtn" class="inline-flex items-center gap-2 border border-border rounded-lg px-3.5 py-2 text-xs font-semibold text-foreground bg-card hover:bg-muted transition-colors @disabledClass">
                        <i class="bi bi-file-earmark-pdf text-destructive"></i> Eksportuj PDF
                    </button>
                    <button type="button" onclick="exportKorisnici('excel')" @disabledAttr id="exportExcelBtn" class="inline-flex items-center gap-2 border border-border rounded-lg px-3.5 py-2 text-xs font-semibold text-foreground bg-card hover:bg-muted transition-colors @disabledClass">
                        <i class="bi bi-file-earmark-excel text-success"></i> Eksportuj Excel
                    </button>
                </div>

                <div class="flex gap-3">
                    @if (jePretrazeno)
                    {
                        <a href="/admin/korisnici" class="inline-flex items-center gap-2 border border-border rounded-lg px-4 py-2 text-xs font-semibold text-foreground bg-card hover:bg-muted transition-colors no-underline">
                            <i class="bi bi-x-circle"></i> Resetuj
                        </a>
                    }
                    <button type="submit" class="inline-flex items-center gap-2 bg-primary text-primary-foreground font-semibold px-5 py-2 rounded-lg text-sm hover:opacity-90 transition-opacity border-0 cursor-pointer">
                        <i class="bi bi-search"></i> Pretraži
                    </button>
                </div>
            </div>
        </form>
    </div>

    @if (!jePretrazeno)
    {
        <div class="bg-card rounded-xl border border-border p-12 text-center text-muted-foreground shadow-sm">
            <div class="w-16 h-16 rounded-full bg-primary/10 text-primary flex items-center justify-center mx-auto mb-4">
                <i class="bi bi-search text-2xl"></i>
            </div>
            <h3 class="text-base font-bold text-foreground mb-1">Pretraga korisnika</h3>
            <p class="text-xs text-muted-foreground max-w-sm mx-auto">Unesite ključnu riječ ili izaberite filtere i kliknite na dugme <strong>Pretraži</strong> da biste učitali korisnike.</p>
        </div>
    }
    else
    {
    <div class="grid grid-cols-2 md:grid-cols-6 gap-4 mb-6">
        <div class="bg-card rounded-xl border border-border p-3 shadow-sm text-center">
            <p class="text-xs text-muted-foreground mb-1">Ukupno</p>
            <p class="text-xl font-bold text-foreground leading-none">@Model.UkupnoKorisnika</p>
        </div>
        <div class="bg-card rounded-xl border border-border p-3 shadow-sm text-center">
            <p class="text-xs text-muted-foreground mb-1">Vozači</p>
            <p class="text-xl font-bold text-primary leading-none">@Model.BrojVozaca</p>
        </div>
        <div class="bg-card rounded-xl border border-border p-3 shadow-sm text-center">
            <p class="text-xs text-muted-foreground mb-1">Menadžeri</p>
            <p class="text-xl font-bold text-warning leading-none">@Model.BrojMenadzera</p>
        </div>
        <div class="bg-card rounded-xl border border-border p-3 shadow-sm text-center">
            <p class="text-xs text-muted-foreground mb-1">Admini</p>
            <p class="text-xl font-bold text-success leading-none">@Model.BrojAdministratora</p>
        </div>
        <div class="bg-card rounded-xl border border-border p-3 shadow-sm text-center">
            <p class="text-xs text-muted-foreground mb-1">Aktivni</p>
            <p class="text-xl font-bold text-success leading-none">@Model.BrojAktivnih</p>
        </div>
        <div class="bg-card rounded-xl border border-border p-3 shadow-sm text-center">
            <p class="text-xs text-muted-foreground mb-1">Blokirani</p>
            <p class="text-xl font-bold text-destructive leading-none">@Model.BrojZakljucanih</p>
        </div>
    </div>

    <!-- Users Cards List -->
    <div class="space-y-4" id="usersListContainer">
        @if (Model.Korisnici != null && Model.Korisnici.Any())
        {
            @foreach (var k in Model.Korisnici)
            {
                var initials = "";
                if (!string.IsNullOrEmpty(k.Ime)) initials += k.Ime[0];
                if (!string.IsNullOrEmpty(k.Prezime)) initials += k.Prezime[0];
                initials = initials.ToUpper();

                var roleColor = "bg-primary/10 text-primary";
                if (k.Uloga == "Administrator") roleColor = "bg-destructive/10 text-destructive";
                else if (k.Uloga == "Menadzer") roleColor = "bg-warning/15 text-warning";

                var statusLabel = k.JeZakljucan ? "Blokiran" : (k.Aktivan ? "Aktivan" : "Neaktivan");
                var statusBg = k.JeZakljucan ? "bg-destructive text-white" : (k.Aktivan ? "bg-success/15 text-success" : "bg-muted text-muted-foreground");

                <div class="user-list-item bg-card rounded-xl border border-border p-6 shadow-sm relative transition-all hover:shadow-md" data-name="@(k.Ime + " " + k.Prezime)" data-email="@k.Email">
                    <div class="flex justify-between items-start mb-4">
                        <div class="flex items-center gap-3">
                            <div class="w-12 h-12 rounded-full bg-muted flex items-center justify-center font-bold text-foreground text-sm shrink-0">
                                @initials
                            </div>
                            <div>
                                <div class="flex items-center gap-2 flex-wrap">
                                    <h2 class="text-base font-bold text-foreground mb-0">@k.Ime @k.Prezime</h2>
                                    <span class="text-[10px] px-2 py-0.5 rounded font-semibold @roleColor">@k.Uloga</span>
                                    <span class="text-[10px] px-2 py-0.5 rounded font-semibold @statusBg">@statusLabel</span>
                                </div>
                                <p class="text-xs text-muted-foreground mt-1 mb-0 flex items-center gap-1">
                                    <i class="bi bi-envelope"></i> @k.Email
                                </p>
                            </div>
                        </div>

                        <!-- Actions Dropdown -->
                        <div class="relative actions-dropdown">
                            <button onclick="toggleDropdown(this)" class="text-muted-foreground hover:text-foreground bg-transparent border-0 cursor-pointer p-1" title="Akcije">
                                <i class="bi bi-three-dots-vertical text-lg"></i>
                            </button>
                            <div class="hidden absolute right-0 mt-1 w-36 bg-card border border-border rounded-lg shadow-lg py-1 z-10">
                                <a href="/admin/korisnici/detalji/@k.Id" class="block px-4 py-2 text-xs text-foreground hover:bg-muted no-underline">
                                    <i class="bi bi-eye me-1.5"></i> Detalji
                                </a>
                                <a href="/admin/korisnici/uredi/@k.Id" class="block px-4 py-2 text-xs text-foreground hover:bg-muted no-underline">
                                    <i class="bi bi-pencil me-1.5"></i> Uredi
                                </a>
                                @if (k.JeZakljucan)
                                {
                                    <form method="post" action="/admin/korisnici/otkljucaj/@k.Id" onsubmit="return confirm('Da li ste sigurni da želite deblokirati ovog korisnika?');" class="block w-full text-start m-0">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@k.Id" />
                                        <button type="submit" class="w-full text-start px-4 py-2 text-xs text-success hover:bg-success/10 bg-transparent border-0 cursor-pointer">
                                            <i class="bi bi-unlock me-1.5"></i> Deblokiraj
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <form method="post" action="/admin/korisnici/zakljucaj/@k.Id" onsubmit="return confirm('Da li ste sigurni da želite blokirati ovog korisnika?');" class="block w-full text-start m-0">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@k.Id" />
                                        <button type="submit" class="w-full text-start px-4 py-2 text-xs text-destructive hover:bg-destructive/10 bg-transparent border-0 cursor-pointer">
                                            <i class="bi bi-lock me-1.5"></i> Blokiraj
                                        </button>
                                    </form>
                                }
                                <form method="post" action="/admin/korisnici/obrisi/@k.Id" onsubmit="return confirm('Da li ste sigurni da želite trajno obrisati ovog korisnika?');" class="block w-full text-start m-0 border-t border-border mt-1 pt-1">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@k.Id" />
                                    <button type="submit" class="w-full text-start px-4 py-2 text-xs text-destructive hover:bg-destructive/10 bg-transparent border-0 cursor-pointer">
                                        <i class="bi bi-trash me-1.5"></i> Obriši
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-y-2 gap-x-8 text-xs text-muted-foreground border-t border-border pt-4 mt-2">
                        <div class="flex items-center gap-2">
                            <i class="bi bi-calendar-event"></i>
                            <span>Registrovan: @k.DatumRegistracije.ToString("dd.MM.yyyy")</span>
                        </div>
                        <div class="flex items-center justify-between md:justify-end gap-2">
                            <span>Ukupno rezervacija: <strong>@k.BrojRezervacija</strong></span>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="bg-card rounded-xl border border-border p-8 text-center text-muted-foreground">
                <i class="bi bi-people text-2xl mb-2 block"></i>
                Nema korisnika koji odgovaraju zadanim filterima.
            </div>
        }
    </div>
}
</div>

@section Scripts {
    <script>
        function toggleDropdown(button) {
            var dropdownMenu = button.nextElementSibling;
            document.querySelectorAll('.actions-dropdown div').forEach(function(el) {
                if (el !== dropdownMenu) {
                    el.classList.add('hidden');
                }
            });
            dropdownMenu.classList.toggle('hidden');
        }

        window.addEventListener('click', function(e) {
            if (!e.target.closest('.actions-dropdown')) {
                document.querySelectorAll('.actions-dropdown div').forEach(function(el) {
                    el.classList.add('hidden');
                });
            }
        });

        function exportKorisnici(format) {
            // Gather current filter params
            var params = new URLSearchParams(window.location.search);

            // Build a printable table from currently rendered rows
            var rows = document.querySelectorAll('.user-list-item');

            if (format === 'pdf') {
                // Build printable HTML
                var printContent = '<html><head><title>Korisnici - SmartPark</title>';
                printContent += '<style>body{font-family:Arial,sans-serif;padding:20px;}table{border-collapse:collapse;width:100%;}th,td{border:1px solid #ddd;padding:8px;text-align:left;}th{background:#f0f0f0;font-weight:bold;}h1{margin-bottom:16px;}p{color:#666;margin-bottom:12px;}</style>';
                printContent += '</head><body>';
                printContent += '<h1>Upravljanje korisnicima - SmartPark</h1>';
                printContent += '<p>Izvještaj generisan: ' + new Date().toLocaleString('bs') + '</p>';
                printContent += '<table><thead><tr><th>Ime i prezime</th><th>Email</th><th>Uloga</th><th>Status</th><th>Datum registracije</th><th>Rezervacije</th></tr></thead><tbody>';

                rows.forEach(function(row) {
                    var name = row.getAttribute('data-name') || '';
                    var email = row.getAttribute('data-email') || '';
                    var uloga = row.querySelector('[class*="text-[10px]"]:first-of-type')?.innerText || '';
                    var status = row.querySelector('[class*="text-[10px]"]:nth-of-type(2)')?.innerText || '';
                    var datum = row.querySelector('.bi-calendar-event')?.parentElement?.querySelector('span')?.innerText?.replace('Registrovan: ', '') || '';
                    var rezervacije = row.querySelector('strong')?.innerText || '0';
                    printContent += '<tr><td>' + name + '</td><td>' + email + '</td><td>' + uloga + '</td><td>' + status + '</td><td>' + datum + '</td><td>' + rezervacije + '</td></tr>';
                });

                printContent += '</tbody></table></body></html>';

                var win = window.open('', '_blank');
                win.document.write(printContent);
                win.document.close();
                win.focus();
                win.print();
                win.close();

            } else if (format === 'excel') {
                // Build CSV/TSV data and trigger download
                var csvContent = '\uFEFF'; // BOM for UTF-8
                csvContent += 'Ime i prezime\tEmail\tUloga\tStatus\tDatum registracije\tBroj rezervacija\n';

                rows.forEach(function(row) {
                    var name = row.getAttribute('data-name') || '';
                    var email = row.getAttribute('data-email') || '';
                    var badges = row.querySelectorAll('[class*="text-[10px]"]');
                    var uloga = badges[0]?.innerText?.trim() || '';
                    var status = badges[1]?.innerText?.trim() || '';
                    var datum = '';
                    var calendarEl = row.querySelector('.bi-calendar-event');
                    if (calendarEl) {
                        var spans = calendarEl.parentElement.querySelectorAll('span');
                        spans.forEach(function(s) { var t = s.innerText.replace('Registrovan: ', '').trim(); if (t) datum = t; });
                    }
                    var rezervacije = row.querySelector('strong')?.innerText?.trim() || '0';
                    csvContent += '"' + name + '"\t"' + email + '"\t"' + uloga + '"\t"' + status + '"\t"' + datum + '"\t' + rezervacije + '\n';
                });

                var blob = new Blob([csvContent], { type: 'application/vnd.ms-excel;charset=utf-8;' });
                var link = document.createElement('a');
                link.href = URL.createObjectURL(blob);
                link.download = 'korisnici_smartpark_' + new Date().toISOString().slice(0,10) + '.xls';
                link.click();
            }
        }
    </script>
}
