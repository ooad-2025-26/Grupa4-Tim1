@{
    ViewData["Title"] = "Profil";
}

<div class="d-flex justify-content-center py-5 px-3" style="min-height:calc(100vh - 56px);background:#f7f7f8">
  <div style="max-width:480px;width:100%">
    <div class="card p-5 text-center mb-3">
      <div class="bg-primary bg-opacity-10 text-primary rounded-circle d-inline-flex align-items-center justify-content-center mx-auto mb-3" style="width:72px;height:72px;font-size:1.5rem;font-weight:700">AH</div>
      <h4 class="fw-bold mb-0">Amer Hodžić</h4>
      <small class="text-muted">amer@example.com</small>
      <div class="mt-2"><span class="badge bg-primary bg-opacity-10 text-primary">Vozač</span></div>
    </div>
    <div class="card p-4">
      <h6 class="fw-semibold mb-3">Informacije o korisniku</h6>
      <div class="border-bottom py-2 d-flex align-items-center gap-3"><i class="bi bi-person text-muted"></i><span class="text-muted small" style="width:120px">Ime i prezime</span><span class="small fw-medium ms-auto">Amer Hodžić</span></div>
      <div class="border-bottom py-2 d-flex align-items-center gap-3"><i class="bi bi-envelope text-muted"></i><span class="text-muted small" style="width:120px">Email</span><span class="small fw-medium ms-auto">amer@example.com</span></div>
      <div class="border-bottom py-2 d-flex align-items-center gap-3"><i class="bi bi-shield text-muted"></i><span class="text-muted small" style="width:120px">Uloga</span><span class="small fw-medium ms-auto">Vozač</span></div>
      <div class="py-2 d-flex align-items-center gap-3"><i class="bi bi-calendar text-muted"></i><span class="text-muted small" style="width:120px">Registrovan</span><span class="small fw-medium ms-auto">2025-01-15</span></div>
      <div class="d-flex gap-2 mt-4">
        <button class="btn btn-primary flex-fill btn-sm"><i class="bi bi-pencil"></i> Uredi profil</button>
        <a href="@Url.Action("Login", "Korisnik")" class="btn btn-danger flex-fill btn-sm"><i class="bi bi-box-arrow-right"></i> Odjavi se</a>
      </div>
    </div>
  </div>
</div>