<tr><td class="fw-medium">Selma Begović</td><td class="text-muted">selma@example.com</td><td><span class="badge bg-primary bg-opacity-10 text-primary" style="font-size:0.7rem">Vozač</span></td><td><span class="badge bg-success bg-opacity-10 text-success" style="font-size:0.7rem">Aktivan</span></td><td class="text-muted">2025-02-10</td><td class="text-end"><button class="btn btn-link btn-sm text-primary p-0 me-2">Uloga</button><button class="btn btn-link btn-sm text-warning p-0 me-2">Blokiraj</button><button class="btn btn-link btn-sm text-danger p-0">Obriši</button></td></tr>
<tr><td class="fw-medium">Edin Karić</td><td class="text-muted">edin@example.com</td><td><span class="badge bg-primary bg-opacity-10 text-primary" style="font-size:0.7rem">Vozač</span></td><td><span class="badge bg-success bg-opacity-10 text-success" style="font-size:0.7rem">Aktivan</span></td><td class="text-muted">2025-03-01</td><td class="text-end"><button class="btn btn-link btn-sm text-primary p-0 me-2">Uloga</button><button class="btn btn-link btn-sm text-warning p-0 me-2">Blokiraj</button><button class="btn btn-link btn-sm text-danger p-0">Obriši</button></td></tr>
<tr><td class="fw-medium">Jasmina Mulić</td><td class="text-muted">jasmina@example.com</td><td><span class="badge bg-primary bg-opacity-10 text-primary" style="font-size:0.7rem">Menadžer</span></td><td><span class="badge bg-success bg-opacity-10 text-success" style="font-size:0.7rem">Aktivan</span></td><td class="text-muted">2025-01-05</td><td class="text-end"><button class="btn btn-link btn-sm text-primary p-0 me-2">Uloga</button><button class="btn btn-link btn-sm text-warning p-0 me-2">Blokiraj</button><button class="btn btn-link btn-sm text-danger p-0">Obriši</button></td></tr>
<tr><td class="fw-medium">Admin Sistem</td><td class="text-muted">admin@example.com</td><td><span class="badge bg-primary bg-opacity-10 text-primary" style="font-size:0.7rem">Administrator</span></td><td><span class="badge bg-success bg-opacity-10 text-success" style="font-size:0.7rem">Aktivan</span></td><td class="text-muted">2024-12-01</td><td class="text-end"><button class="btn btn-link btn-sm text-primary p-0 me-2">Uloga</button><button class="btn btn-link btn-sm text-warning p-0 me-2">Blokiraj</button><button class="btn btn-link btn-sm text-danger p-0">Obriši</button></td></tr>
