@{
    ViewData["Title"] = "Upravljanje korisnicima";
}

<div class="container py-4">
  <div class="d-flex justify-content-between align-items-center mb-4"><h4 class="fw-bold mb-0">Upravljanje korisnicima</h4><button class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#addModal">Dodaj korisnika</button></div>
  <div class="d-flex gap-2 mb-4">
    <input class="form-control form-control-sm" style="max-width:250px" placeholder="Pretraži...">
    <select class="form-select form-select-sm" style="max-width:150px"><option>Sve uloge</option><option>Vozač</option><option>Menadžer</option><option>Admin</option></select>
  </div>
  <div class="card"><div class="table-responsive"><table class="table table-sm mb-0 small">
