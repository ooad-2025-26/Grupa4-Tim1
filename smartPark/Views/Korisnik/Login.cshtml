@{
    ViewData["Title"] = "Prijava";
}

<div class="container d-flex align-items-center justify-content-center" style="min-height:100vh">
  <div class="card p-4 shadow-sm" style="max-width:420px;width:100%">
    <h3 class="text-center fw-bold mb-4">Prijava</h3>
    <form action="/index.html">
      <div class="mb-3"><label class="form-label small fw-medium">Email</label><input type="email" class="form-control" placeholder="email@example.com" required></div>
      <div class="mb-3"><label class="form-label small fw-medium">Lozinka</label><input type="password" class="form-control" placeholder="••••••••" required></div>
      <button class="btn btn-primary w-100">Prijavi se</button>
    </form>
    <div class="text-center mt-3"><a href="#" class="text-muted small">Zaboravili ste lozinku?</a></div>
    <p class="text-center mt-2 small text-muted">Nemate račun? <a href="@Url.Action("Register", "Korisnik")" class="text-primary fw-medium">Registrujte se</a></p>
    <div class="bg-light rounded p-3 mt-3 small text-muted">
      <p class="fw-medium mb-1">Demo nalozi:</p>
      <p class="mb-0">Vozač: amer@example.com / password123</p>
      <p class="mb-0">Menadžer: jasmina@example.com / password123</p>
      <p class="mb-0">Admin: admin@example.com / admin123</p>
    </div>
  </div>
</div>