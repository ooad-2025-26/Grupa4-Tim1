@model smartPark.Models.ViewModels.Korisnik.Menadzer.MenadzerRadniciViewModel

@{
    ViewBag.Title = "Radnici na parkingu";
}

<div class="container py-4">
    <div class="row mb-4">
        <div class="col-12">
            <button onclick="history.back()" class="btn btn-back mb-2"><i class="bi bi-arrow-left"></i> Nazad</button>
            <h2 class="fw-bold mb-1">Status radnika</h2>
            <p class="text-muted">Pregled radnika angažovanih na lokacijama i njihovog statusa aktivnosti</p>
        </div>
    </div>

    <!-- Statistika radnika -->
    <div class="row g-3 mb-4">
        <div class="col-md-6">
            <div class="sp-card text-center p-3">
                <div class="text-muted small">Ukupno registrovanih radnika</div>
                <div class="fs-3 fw-bold">@Model.UkupnoRadnika</div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="sp-card text-center p-3">
                <div class="text-muted small">Trenutno aktivno (na smjeni)</div>
                <div class="fs-3 fw-bold text-success">@Model.BrojAktivnihDanas</div>
            </div>
        </div>
    </div>

    <!-- Tabela radnika -->
    <div class="sp-card">
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead>
                    <tr>
                        <th>Ime i prezime</th>
                        <th>Email adresa</th>
                        <th>Status uloge</th>
                        <th>Status računa</th>
                        <th>Datum registracije</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Radnici.Any())
                    {
                        foreach (var radnik in Model.Radnici)
                        {
                            <tr>
                                <td>
                                    <div class="fw-semibold text-dark">@radnik.Ime @radnik.Prezime</div>
                                </td>
                                <td>@radnik.Email</td>
                                <td><span class="badge bg-info text-dark">Radnik</span></td>
                                <td>
                                    @if (radnik.JeZakljucan)
                                    {
                                        <span class="badge bg-danger">Zaključan</span>
                                    }
                                    else if (radnik.Aktivan)
                                    {
                                        <span class="badge bg-success">Aktivan</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark">Neaktivan</span>
                                    }
                                </td>
                                <td class="text-muted small">@radnik.DatumRegistracije.ToString("dd.MM.yyyy HH:mm")</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center py-4 text-muted">
                                <i class="bi bi-info-circle"></i> Nema registrovanih radnika u sistemu.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
