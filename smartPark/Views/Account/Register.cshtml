@model smartPark.Models.ViewModels.Korisnik.RegisterViewModel

@{
    ViewBag.Title = "Registracija";
}

<div class="min-h-[calc(100vh-3.5rem)] flex items-center justify-center p-4">
    <div class="bg-card rounded-lg shadow-lg border border-border p-8 w-full max-w-md">
        <div class="flex justify-center mb-6">
            <img src="~/LOGO.png" alt="SmartPark Logo" class="h-16" />
        </div>
        <h1 class="text-2xl font-bold text-center mb-6 text-foreground">Registracija</h1>
        <form asp-action="Register" asp-controller="Korisnik" method="post" class="space-y-4">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-destructive text-sm"></div>

            <div class="grid grid-cols-2 gap-3">
                <div>
                    <label asp-for="Ime" class="block text-sm font-medium text-foreground mb-1">Ime</label>
                    <input asp-for="Ime" required class="w-full px-3 py-2 rounded-lg border border-input bg-background text-foreground text-sm focus:outline-none focus:ring-2 focus:ring-ring" />
                    <span asp-validation-for="Ime" class="text-destructive text-xs"></span>
                </div>
                <div>
                    <label asp-for="Prezime" class="block text-sm font-medium text-foreground mb-1">Prezime</label>
                    <input asp-for="Prezime" required class="w-full px-3 py-2 rounded-lg border border-input bg-background text-foreground text-sm focus:outline-none focus:ring-2 focus:ring-ring" />
                    <span asp-validation-for="Prezime" class="text-destructive text-xs"></span>
                </div>
            </div>

            <div>
                <label asp-for="Email" class="block text-sm font-medium text-foreground mb-1">Email</label>
                <input asp-for="Email" type="email" required class="w-full px-3 py-2 rounded-lg border border-input bg-background text-foreground text-sm focus:outline-none focus:ring-2 focus:ring-ring" placeholder="primjer@gmail.com" />
                <span asp-validation-for="Email" class="text-destructive text-xs"></span>
            </div>

            <div>
                <label asp-for="BrojVozacke" class="block text-sm font-medium text-foreground mb-1">Broj tablica</label>
                <input asp-for="BrojVozacke" required class="w-full px-3 py-2 rounded-lg border border-input bg-background text-foreground text-sm focus:outline-none focus:ring-2 focus:ring-ring" />
                <span asp-validation-for="BrojVozacke" class="text-destructive text-xs"></span>
            </div>

            <div>
                <label asp-for="Password" class="block text-sm font-medium text-foreground mb-1">Lozinka</label>
                <input asp-for="Password" type="password" required class="w-full px-3 py-2 rounded-lg border border-input bg-background text-foreground text-sm focus:outline-none focus:ring-2 focus:ring-ring" placeholder="••••••••" />
                <span asp-validation-for="Password" class="text-destructive text-xs"></span>
            </div>

            <div>
                <label asp-for="ConfirmPassword" class="block text-sm font-medium text-foreground mb-1">Potvrdi lozinku</label>
                <input asp-for="ConfirmPassword" type="password" required class="w-full px-3 py-2 rounded-lg border border-input bg-background text-foreground text-sm focus:outline-none focus:ring-2 focus:ring-ring" placeholder="••••••••" />
                <span asp-validation-for="ConfirmPassword" class="text-destructive text-xs"></span>
            </div>

            <button type="submit" class="w-full bg-primary text-white py-2.5 rounded-lg font-medium text-sm hover:opacity-90 transition-opacity">Registruj se</button>
        </form>
        <p class="mt-4 text-center text-sm text-muted-foreground">Već imate račun? <a asp-action="Login" asp-controller="Korisnik" class="text-primary hover:underline font-medium">Prijavite se</a></p>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
