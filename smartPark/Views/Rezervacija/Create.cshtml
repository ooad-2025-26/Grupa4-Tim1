@{
    ViewData["Title"] = "Rezervacija parkinga";
}

<div class="container py-4" style="max-width:480px">
  <div class="card p-4">
    <a href="javascript:history.back()" class="text-muted small text-decoration-none mb-3 d-inline-block"><i class="bi bi-arrow-left"></i> Nazad</a>
    <h4 class="fw-bold mb-4">Potvrda i plaćanje</h4>
    <div class="bg-light rounded p-3 mb-4">
      <div class="d-flex justify-content-between small mb-1"><span class="text-muted">Parking:</span><span class="fw-medium">Centar - Zona 1</span></div>
      <div class="d-flex justify-content-between small mb-1"><span class="text-muted">Datum:</span><span class="fw-medium">2026-04-11</span></div>
      <div class="d-flex justify-content-between small mb-1"><span class="text-muted">Vrijeme:</span><span class="fw-medium">10:00</span></div>
      <div class="d-flex justify-content-between small mb-1"><span class="text-muted">Trajanje:</span><span class="fw-medium">60 min</span></div>
      <hr><div class="d-flex justify-content-between small fw-semibold"><span>Ukupno:</span><span class="text-primary">2.50 KM</span></div>
    </div>
    <form id="payForm">
      <div class="mb-3"><label class="form-label small fw-medium">Broj kartice</label><input class="form-control" placeholder="1234 5678 9012 3456" required></div>
      <div class="row mb-3"><div class="col"><label class="form-label small fw-medium">Datum isteka</label><input class="form-control" placeholder="MM/YY" required></div><div class="col"><label class="form-label small fw-medium">CVV</label><input class="form-control" placeholder="123" required></div></div>
      <div class="mb-3"><label class="form-label small fw-medium">Ime na kartici</label><input class="form-control" required></div>
      <button type="submit" class="btn btn-primary w-100">Plati i potvrdi</button>
    </form>
  </div>
  <div class="card p-4 mt-3 text-center d-none" id="successCard">
    <div class="bg-success bg-opacity-10 rounded-circle d-inline-flex align-items-center justify-content-center mx-auto mb-3" style="width:64px;height:64px"><i class="bi bi-check-lg text-success fs-3"></i></div>
    <h5 class="fw-bold">Plaćanje uspješno!</h5>
    <p class="text-muted small">Vaš QR kod za ulaz na parking</p>
    <div class="bg-light p-4 rounded mb-3"><div class="border border-2 border-dashed rounded mx-auto d-flex align-items-center justify-content-center text-muted small" style="width:128px;height:128px">QR: RES-001-ABC123</div></div>
    <div class="d-flex gap-2 justify-content-center"><a href="@Url.Action("Index", "QRKod")" class="btn btn-primary btn-sm">Preuzmi QR</a><a href="@Url.Action("Index", "Home")" class="btn btn-light btn-sm">Početna</a></div>
  </div>
</div>

@section Scripts {
<script>
document.getElementById("payForm").addEventListener("submit",function(e){
  e.preventDefault();this.closest(".card").classList.add("d-none");document.getElementById("successCard").classList.remove("d-none");
});
</script>
}
