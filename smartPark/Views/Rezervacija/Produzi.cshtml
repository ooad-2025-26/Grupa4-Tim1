@model smartPark.Models.ViewModels.Rezervacija.RezervacijaProduziViewModel

@{
    ViewBag.Title = "Produži rezervaciju";
}

<div class="min-h-[calc(100vh-3.5rem)] bg-muted/30 py-10 px-4">
    <div class="container mx-auto max-w-lg">
        <!-- Header s dugmetom nazad -->
        <div class="flex items-center gap-4 mb-8">
            <button onclick="history.back()" class="flex items-center justify-center w-10 h-10 rounded-full border border-border bg-card text-muted-foreground hover:text-foreground hover:shadow-sm transition-all cursor-pointer">
                <i class="bi bi-arrow-left text-lg"></i>
            </button>
            <div>
                <h1 class="text-2xl font-bold text-foreground">Produženje rezervacije</h1>
                <p class="text-sm text-muted-foreground mt-0.5">Produžite trajanje vaše trenutne rezervacije</p>
            </div>
        </div>

        <div class="bg-card border border-border rounded-xl p-6 shadow-sm">
            @if (Model != null && Model.RezervacijaId > 0)
            {
                <div class="bg-muted/40 border border-border rounded-lg p-4 mb-5 space-y-3">
                    <div class="flex justify-between items-center border-b border-border/60 pb-2">
                        <span class="text-xs font-semibold text-muted-foreground uppercase tracking-wider">Broj rezervacije</span>
                        <span class="text-sm font-mono font-bold text-foreground">#RES-@Model.RezervacijaId.ToString("D3")</span>
                    </div>
                    <div class="grid grid-cols-2 gap-4 text-sm">
                        <div class="col-span-2">
                            <span class="text-xs text-muted-foreground block">Parking prostor:</span>
                            <strong class="text-foreground">@Model.ParkingNaziv</strong>
                        </div>
                        <div class="col-span-2 sm:col-span-1">
                            <span class="text-xs text-muted-foreground block">Trenutni period boravka:</span>
                            <strong class="text-foreground text-xs">@Model.PocetakRezervacije.ToString("dd.MM.yyyy HH:mm") - @Model.KrajRezervacije.ToString("HH:mm")</strong>
                        </div>
                        <div class="col-span-2 sm:col-span-1">
                            <span class="text-xs text-muted-foreground block">Trenutna cijena:</span>
                            <strong class="text-foreground">@Model.UkupnaCijena.ToString("F2") KM</strong>
                        </div>
                    </div>
                </div>
                
                <form asp-action="ProduziPotvrdi" asp-controller="Rezervacija" asp-route-id="@Model.RezervacijaId" method="post" class="space-y-5">
                    @Html.AntiForgeryToken()
                    
                    <div asp-validation-summary="ModelOnly" class="bg-red-50 border border-red-200 text-red-600 text-xs rounded-lg p-3 hidden"></div>
                    
                    <input type="hidden" name="id" value="@Model.RezervacijaId" />
                    
                    <div class="flex flex-col gap-1.5">
                        <label class="text-sm font-semibold text-foreground">Dodatno vrijeme</label>
                        <select name="dodatnoVrijeme" id="dodatnoVrijeme" class="w-full px-3.5 py-2.5 rounded-lg border border-border bg-background text-foreground text-sm focus:outline-none focus:ring-2 focus:ring-ring focus:border-transparent transition-all cursor-pointer" onchange="izracunajCijenu()">
                            <option value="30">30 minuta</option>
                            <option value="60">1 sat</option>
                            <option value="120">2 sata</option>
                            <option value="240">4 sata</option>
                            <option value="480">8 sati</option>
                            <option value="720">12 sati</option>
                            <option value="1440">24 sata</option>
                        </select>
                    </div>
                    
                    <!-- Prikaz dodatne cijene -->
                    <div class="bg-card border border-border rounded-lg p-4 space-y-2.5" id="cijenaPreview">
                        <div class="flex justify-between items-center text-sm">
                            <span class="text-muted-foreground">Cijena po satu:</span>
                            <span class="font-semibold text-foreground">@Model.CijenaPoSatu.ToString("F2") KM</span>
                        </div>
                        <div class="flex justify-between items-center text-sm">
                            <span class="text-muted-foreground">Dodatno vrijeme:</span>
                            <span class="font-semibold text-foreground" id="dodatnoVrijemeTekst">30 min</span>
                        </div>
                        <hr class="border-border" />
                        <div class="flex justify-between items-center">
                            <span class="text-sm font-medium text-foreground">Dodatna cijena:</span>
                            <span class="text-lg font-bold text-primary" id="dodatnaCijena">@((Model.CijenaPoSatu * 0.5m).ToString("F2")) KM</span>
                        </div>
                    </div>
                    
                    <button type="submit" class="w-full inline-flex items-center justify-center gap-2 bg-primary text-primary-foreground font-semibold px-4 py-3 rounded-lg text-sm hover:opacity-90 transition-opacity cursor-pointer border-0">
                        <i class="bi bi-clock-history text-base"></i> Potvrdi i plati
                    </button>
                </form>
            }
            else
            {
                <div class="bg-red-50 border border-red-200 text-red-600 text-sm rounded-lg p-4 text-center">
                    <i class="bi bi-exclamation-triangle-fill text-2xl mb-2 block"></i>
                    Rezervacija nije pronađena.
                    <a asp-action="MojeRezervacije" class="block mt-2 font-bold text-red-700 hover:underline">Vrati se na moje rezervacije</a>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    
    <script>
        function izracunajCijenu() {
            var select = document.getElementById('dodatnoVrijeme');
            var dodatnoMinuta = parseInt(select.value);
            var cijenaPoSatu = parseFloat("@(Model?.CijenaPoSatu.ToString() ?? "0")".replace(',', '.'));
            
            var dodatnoSati = dodatnoMinuta / 60;
            var dodatnaCijena = cijenaPoSatu * dodatnoSati;
            
            // Formatiranje teksta za dodatno vrijeme
            var vrijemeTekst = dodatnoMinuta + ' min';
            if (dodatnoMinuta >= 60) {
                var sati = dodatnoMinuta / 60;
                if (sati === 1) {
                    vrijemeTekst = '1 sat';
                } else if (sati >= 2 && sati <= 4) {
                    vrijemeTekst = sati + ' sata';
                } else {
                    vrijemeTekst = sati + ' sati';
                }
            }
            
            // Prikaz
            document.getElementById('dodatnoVrijemeTekst').innerText = vrijemeTekst;
            document.getElementById('dodatnaCijena').innerText = dodatnaCijena.toFixed(2).replace('.', ',') + ' KM';
        }
    </script>
}
