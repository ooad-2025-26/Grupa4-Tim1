@{
    ViewData["Title"] = "Menadžer Dashboard";
}

<div class="container py-4">
  <div class="d-flex justify-content-between align-items-center mb-4"><h3 class="fw-bold mb-0">Menadžer Dashboard</h3><a href="@Url.Action("Create", "Parking")" class="btn btn-primary btn-sm">Dodaj parking</a></div>
  <div class="row g-3">
    <div class="col-6 col-lg-3"><div class="card p-4"><div class="d-flex align-items-center gap-3"><i class="bi bi-p-square text-primary fs-4"></i><div><p class="stat-value mb-0">6</p><p class="stat-label mb-0">Parking prostora</p></div></div></div></div>
    <div class="col-6 col-lg-3"><div class="card p-4"><div class="d-flex align-items-center gap-3"><i class="bi bi-car-front text-success fs-4"></i><div><p class="stat-value mb-0">1800</p><p class="stat-label mb-0">Parking mjesta</p></div></div></div></div>
    <div class="col-6 col-lg-3"><div class="card p-4"><div class="d-flex align-items-center gap-3"><i class="bi bi-graph-up text-warning fs-4"></i><div><p class="stat-value mb-0">70%</p><p class="stat-label mb-0">Popunjenost</p></div></div></div></div>
    <div class="col-6 col-lg-3"><div class="card p-4"><div class="d-flex align-items-center gap-3"><i class="bi bi-currency-dollar text-primary fs-4"></i><div><p class="stat-value mb-0">15.00 KM</p><p class="stat-label mb-0">Današnji prihod</p></div></div></div></div>
  </div>
</div>