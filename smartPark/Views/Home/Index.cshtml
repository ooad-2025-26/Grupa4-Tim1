@{
    ViewBag.Title = "Početna";
    var uloga = ViewBag.Uloga as string ?? "gost";
}

@if (uloga == "admin" || uloga == "Administrator")
{
    @await Html.PartialAsync("~/Views/Admin/_Dashboard.cshtml")
}
else if (uloga == "manager" || uloga == "Menadzer")
{
    @await Html.PartialAsync("~/Views/Manager/_Dashboard.cshtml")
}
else if (uloga == "driver" || uloga == "Vozac")
{
    @await Html.PartialAsync("~/Views/Home/_DriverDashboard.cshtml")
}
else
{
    // Ako nije prijavljen, prikaži opšti pozdrav ili preusmjeri na login
    <div class="text-center py-5 flex flex-col items-center">
        <img src="~/LOGO.png" alt="SmartPark Logo" class="h-20 mb-4" />
        <h1 class="display-4">Dobrodošli u SmartPark</h1>
        <p class="lead">Sistem za inteligentno upravljanje parking prostorima</p>
        <hr class="my-4">
        <p>Molimo vas da se prijavite ili registrujete kako biste koristili sistem.</p>
        <div class="d-flex justify-content-center gap-3">
            <a asp-controller="Account" asp-action="Login" class="btn btn-primary">Prijava</a>
            <a asp-controller="Account" asp-action="Register" class="btn btn-outline-secondary">Registracija</a>
        </div>
    </div>
}
