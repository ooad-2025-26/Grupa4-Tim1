@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="container py-4">
  <div class="d-flex justify-content-between align-items-center mb-4"><h3 class="fw-bold mb-0">Admin Dashboard</h3><a href="@Url.Action("Index", "Korisnik")" class="btn btn-primary btn-sm">Upravljaj korisnicima</a></div>
  <div class="row g-3">
    <div class="col-6 col-lg"><div class="card p-4"><div class="d-flex align-items-center gap-2 mb-2"><i class="bi bi-people text-primary"></i><small class="text-muted">Ukupno korisnika</small></div><p class="stat-value mb-0">3</p></div></div>
    <div class="col-6 col-lg"><div class="card p-4"><div class="d-flex align-items-center gap-2 mb-2"><i class="bi bi-shield-check text-success"></i><small class="text-muted">Ukupno menadžera</small></div><p class="stat-value mb-0">1</p></div></div>
    <div class="col-6 col-lg"><div class="card p-4"><div class="d-flex align-items-center gap-2 mb-2"><i class="bi bi-p-square text-warning"></i><small class="text-muted">Ukupno parkinga</small></div><p class="stat-value mb-0">6</p></div></div>
    <div class="col-6 col-lg"><div class="card p-4"><div class="d-flex align-items-center gap-2 mb-2"><i class="bi bi-calendar-check text-info"></i><small class="text-muted">Današnje rezervacije</small></div><p class="stat-value mb-0">3</p></div></div>
    <div class="col-6 col-lg"><div class="card p-4"><div class="d-flex align-items-center gap-2 mb-2"><i class="bi bi-exclamation-triangle text-danger"></i><small class="text-muted">Greške (24h)</small></div><p class="stat-value mb-0">2</p></div></div>
  </div>
</div>