@{
    ViewData["Title"] = "QR kod";
}

<div class="container py-4" style="max-width:600px">
  <div class="d-flex align-items-center gap-3 mb-4"><a href="@Url.Action("Index", "Rezervacija")" class="text-muted"><i class="bi bi-arrow-left"></i></a><div><h4 class="fw-bold mb-0">QR Kod</h4><small class="text-muted">Potvrda rezervacije</small></div></div>
  <div class="card p-5 text-center mb-3">
    <div class="mb-3"><span class="badge-status badge-active">Aktivna</span></div>
    <div class="border rounded p-3 d-inline-block mx-auto mb-3"><div class="border border-2 border-dashed rounded d-flex align-items-center justify-content-center text-muted" style="width:180px;height:180px;font-size:0.75rem">QR: RES-001-ABC123-2026</div></div>
    <p class="text-muted small">Skenirajte ovaj kod na ulazu u parking</p>
    <p class="text-muted" style="font-size:0.7rem">RES-001-ABC123-2026</p>
  </div>
  <div class="card p-4 mb-3">
    <h6 class="fw-semibold mb-1">Detalji rezervacije</h6><small class="text-muted">ID: RES-001</small>
    <div class="mt-3 small">
      <div class="d-flex align-items-center gap-2 mb-2"><i class="bi bi-geo-alt text-muted"></i><div><span class="fw-medium">Centar - Zona 1</span><br><span class="text-muted">Ferhadija 15, Sarajevo</span></div></div>
      <div class="d-flex align-items-center gap-2 mb-2"><i class="bi bi-calendar text-muted"></i> 2026-04-10</div>
      <div class="d-flex align-items-center gap-2 mb-2"><i class="bi bi-clock text-muted"></i> 10:00 - 14:00 (4 sata)</div>
      <div class="d-flex align-items-center gap-2"><i class="bi bi-car-front text-muted"></i> Mjesto: <strong>A-15</strong> | Otvoreni parking</div>
    </div>
  </div>
  <div class="row g-2 mb-3">
    <div class="col-4"><button class="btn btn-light w-100 d-flex flex-column align-items-center gap-1 py-3"><i class="bi bi-download"></i><small>Preuzmi</small></button></div>
    <div class="col-4"><button class="btn btn-light w-100 d-flex flex-column align-items-center gap-1 py-3"><i class="bi bi-share"></i><small>Podijeli</small></button></div>
    <div class="col-4"><button class="btn btn-light w-100 d-flex flex-column align-items-center gap-1 py-3"><i class="bi bi-compass"></i><small>Navigacija</small></button></div>
  </div>
  <a href="@Url.Action("Index", "Rezervacija")" class="btn btn-primary w-100">Nazad na rezervacije</a>
</div>